<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="artifacts" value="../artifacts/packages/" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="artifacts">
      <package pattern="Themis" />
      <package pattern="Themis.Core" />
      <package pattern="Themis.Testing" />
      <package pattern="Themis.Cli" />
    </packageSource>
  </packageSourceMapping>

</configuration>
